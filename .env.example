# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Session signing — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# App URL (used in invite / reset / verify links)
APP_URL="http://localhost:3000"

# Email delivery: "console" logs messages locally; "smtp" uses SMTP_* below
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CRM Solution <noreply@localhost>"

# Billing adapter: "dev" simulates provider events; "stripe" requires keys (not activated by default)
BILLING_PROVIDER="dev"
BILLING_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Demo seed flag — never enable in production
SEED_DEMO_DATA="true"
