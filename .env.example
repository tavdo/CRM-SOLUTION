# Database — SQLite for local/demo. For production Postgres see docs/PRODUCTION.md
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/crm?sslmode=require"

# Session signing — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# App URL (used in invite / reset / verify links + public web form embeds)
APP_URL="http://localhost:3000"

# Optional public preview with immediate database accounts and email delivery disabled.
# Set both DEPLOYMENT_MODE=preview and REGISTRATION_MODE=database to enable it.
# Leave REGISTRATION_MODE unset (or verified) to retain normal email verification.
# REGISTRATION_MODE="verified"

# Email delivery: "console" logs locally; set EMAIL_TRANSPORT=smtp + SMTP_* for real mail
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CRM Solution <noreply@localhost>"

# Billing adapter: "dev" simulates provider events; "stripe" requires keys (not activated by default)
BILLING_PROVIDER="dev"
BILLING_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Demo seed flag — never enable in production
SEED_DEMO_DATA="true"

# Inbox: generate once with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key backed up; changing it makes saved channel credentials unreadable.
INBOX_ENCRYPTION_KEY=""
REDIS_URL="redis://127.0.0.1:6379"
META_GRAPH_VERSION="v24.0"
INBOX_STORAGE="local"
INBOX_STORAGE_PATH="storage/inbox"
# Production object storage uses the AWS SDK default credential chain / IAM role.
# INBOX_STORAGE="s3"
# AWS_REGION="us-east-1"
# S3_BUCKET="private-crm-media"
# S3_ENDPOINT="https://your-s3-compatible-endpoint"
VIBER_SENDER_NAME="CRM"
