# Copy to an ignored .env.live.local or set directly in the chosen host.
# Never put real secrets in this tracked example. Free plans only; no card/upgrade.
DEPLOYMENT_MODE="live"
# Runtime pooler URL; for Supabase use the connection string from its dashboard.
DATABASE_URL="postgresql://USER:REPLACE_ME@HOST:6543/postgres?schema=crm&pgbouncer=true&connection_limit=3&sslmode=require"
# Direct connection or Supabase session pooler (5432) for migrations and backups.
DIRECT_URL="postgresql://USER:REPLACE_ME@HOST:5432/postgres?schema=crm&sslmode=require"
SESSION_SECRET="REPLACE_ME_WITH_32_OR_MORE_RANDOM_CHARACTERS"
SEED_DEMO_DATA="false"
APP_URL="https://YOUR-DOMAIN.ge"
EMAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="REPLACE_ME_WITH_RESEND_KEY"
SMTP_FROM="CRM Solution <noreply@YOUR-DOMAIN.ge>"
SUPPORT_EMAIL="REPLACE_ME_WITH_MONITORED_EMAIL"
OPERATOR_NAME=""
# Use a single-IP header that your host OVERWRITES. Never trust a client-supplied header.
TRUSTED_IP_HEADER=""
FILE_STORAGE="s3"
INBOX_STORAGE="s3"
S3_BUCKET="crm-private"
# Supabase: region and S3 endpoint from Storage > S3 settings.
S3_REGION="REPLACE_ME"
S3_ENDPOINT="https://PROJECT-REF.storage.supabase.co/storage/v1/s3"
S3_ACCESS_KEY_ID="REPLACE_ME"
S3_SECRET_ACCESS_KEY="REPLACE_ME"
# Keep messaging off until real accounts, Redis and worker are ready.
INBOX_ENABLED="false"
INBOX_ENCRYPTION_KEY=""
REDIS_URL=""
META_GRAPH_VERSION="v24.0"
VIBER_SENDER_NAME="CRM"
BILLING_PROVIDER="disabled"
# Independent encryption key for backup archives. Keep outside the archive.
BACKUP_ENCRYPTION_KEY=""
