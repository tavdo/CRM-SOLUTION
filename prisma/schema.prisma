generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  preferredLocale   String    @default("en") // en | ka
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships           Membership[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  emailVerifyTokens     EmailVerifyToken[]
  ownedCustomers        Customer[]           @relation("CustomerOwner")
  ownedContacts         Contact[]            @relation("ContactOwner")
  ownedDeals            Deal[]               @relation("DealOwner")
  ownedTasks            Task[]               @relation("TaskOwner")
  createdTasks          Task[]               @relation("TaskCreator")
  ownedLeads            Lead[]               @relation("LeadOwner")
  notes                 Note[]
  auditEvents           AuditEvent[]         @relation("AuditActor")
  invitationsSent       Invitation[]         @relation("InviteSender")
  feedPosts             FeedPost[]
  chatMessages          ChatMessage[]
  workLogs              WorkLog[]
  leaveRequests         LeaveRequest[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerifyToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Asia/Tbilisi")
  defaultLocale String   @default("ka")
  currency      String   @default("GEL")
  // Georgian Business Identity (ს/კ, დღგ, BOG/TBC IBAN)
  taxId         String?  // 9-digit საიდენტიფიკაციო კოდი (ს/კ)
  legalForm     String   @default("შპს") // შპს | სს | ი/მ | ფიზიკური პირი
  isVatPayer    Boolean  @default(true) // დღგ-ს გადამხდელი (18%)
  bogIban       String?  // საქართველოს ბანკი IBAN (GE..BG..)
  tbcIban       String?  // თიბისი ბანკი IBAN (GE..TB..)
  address       String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  customers        Customer[]
  contacts         Contact[]
  pipelineStages   PipelineStage[]
  deals            Deal[]
  tasks            Task[]
  leads            Lead[]
  products         Product[]
  invoices         Invoice[]
  feedPosts        FeedPost[]
  chatMessages     ChatMessage[]
  departments      Department[]
  workLogs         WorkLog[]
  leaveRequests    LeaveRequest[]
  automationRules  AutomationRule[]
  customFields     CustomFieldDefinition[]
  notes            Note[]
  auditEvents      AuditEvent[]
  subscription     Subscription?
  dealActivities   DealActivity[]
}

model Membership {
  id             String   @id @default(cuid())
  companyId      String
  userId         String
  role           Role     @default(EMPLOYEE)
  departmentName String?
  jobTitle       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Invitation {
  id          String       @id @default(cuid())
  companyId   String
  email       String
  role        Role         @default(EMPLOYEE)
  tokenHash   String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([companyId, email])
  @@index([expiresAt])
}

model Customer {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  taxId       String?   // 9-digit საიდენტიფიკაციო კოდი (ს/კ)
  legalForm   String?   @default("შპს")
  isVatPayer  Boolean   @default(true)
  bankIban    String?
  email       String?
  phone       String?
  website     String?
  address     String?
  ownerId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner        User?               @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  tasks        Task[]
  invoices     Invoice[]
  notes        Note[]
  customValues CustomFieldValue[]

  @@index([companyId, name])
  @@index([companyId, archivedAt])
  @@index([companyId, ownerId])
}

model Contact {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String?
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  ownerId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner    User?     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes    Note[]
  deals    Deal[]    @relation("DealPrimaryContact")

  @@index([companyId, lastName, firstName])
  @@index([companyId, customerId])
  @@index([companyId, ownerId])
}

model CustomFieldDefinition {
  id         String          @id @default(cuid())
  companyId  String
  name       String
  key        String
  fieldType  CustomFieldType
  options    String? // JSON array for SELECT
  required   Boolean         @default(false)
  sortOrder  Int             @default(0)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
}

model CustomFieldValue {
  id          String    @id @default(cuid())
  companyId   String
  fieldId     String
  customerId  String
  valueText   String?
  valueNumber Float?
  valueDate   DateTime?

  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([fieldId, customerId])
  @@index([companyId, customerId])
}

model Note {
  id         String   @id @default(cuid())
  companyId  String
  body       String
  authorId   String
  customerId String?
  contactId  String?
  dealId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
  @@index([companyId, dealId])
}

model PipelineStage {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  sortOrder  Int
  isWon      Boolean   @default(false)
  isLost     Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals   Deal[]

  @@index([companyId, sortOrder])
}

model Deal {
  id              String     @id @default(cuid())
  companyId       String
  title           String
  customerId      String?
  contactId       String?
  stageId         String
  ownerId         String?
  amountMinor     Int        @default(0)
  currency        String     @default("GEL")
  expectedCloseAt DateTime?
  status          DealStatus @default(OPEN)
  lossReason      String?
  closedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation("DealPrimaryContact", fields: [contactId], references: [id], onDelete: SetNull)
  stage      PipelineStage  @relation(fields: [stageId], references: [id])
  owner      User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  invoices   Invoice[]
  notes      Note[]
  activities DealActivity[]

  @@index([companyId, stageId])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, expectedCloseAt])
}

model DealActivity {
  id        String   @id @default(cuid())
  companyId String
  dealId    String
  actorId   String?
  action    String
  detail    String? // JSON metadata, no secrets
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId, dealId, createdAt])
}

model Task {
  id            String     @id @default(cuid())
  companyId     String
  title         String
  description   String?
  status        TaskStatus @default(OPEN)
  priority      String     @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  boardStage    String     @default("TODO")   // TODO | IN_PROGRESS | REVIEW | DONE
  checklistJson String?    // JSON array of { text, done }
  dueAt         DateTime?
  completedAt   DateTime?
  ownerId       String
  creatorId     String
  customerId    String?
  dealId        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner    User      @relation("TaskOwner", fields: [ownerId], references: [id])
  creator  User      @relation("TaskCreator", fields: [creatorId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([companyId, ownerId, status])
  @@index([companyId, dueAt])
  @@index([companyId, dealId])
}

// —— Bitrix24-style Leads Inbox (ლიდები) ——
model Lead {
  id                  String   @id @default(cuid())
  companyId           String
  title               String
  contactName         String
  companyName         String?
  taxId               String?  // ს/კ
  phone               String?
  email               String?
  source              String   @default("FACEBOOK") // FACEBOOK | INSTAGRAM | WHATSAPP | WEBSITE | MYPHONE | REFERRAL
  status              String   @default("NEW")      // NEW | CONTACTED | QUALIFIED | CONVERTED | JUNK
  amountMinor         Int      @default(0)
  currency            String   @default("GEL")
  notes               String?
  ownerId             String?
  convertedCustomerId String?
  convertedDealId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, source])
}

// —— Products & Services Catalog (პროდუქტები) ——
model Product {
  id          String   @id @default(cuid())
  companyId   String
  sku         String?
  name        String
  description String?
  unit        String   @default("ცალი") // ცალი | თვე | საათი | პაკეტი
  priceMinor  Int      @default(0)
  currency    String   @default("GEL")
  vatIncluded Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   InvoiceItem[]

  @@index([companyId, name])
}

// —— Georgian Invoices (ინვოისები — ს/კ, დღგ 18%, BOG/TBC IBAN, RS.ge) ——
model Invoice {
  id              String    @id @default(cuid())
  companyId       String
  invoiceNumber   String
  customerId      String
  dealId          String?
  status          String    @default("SENT") // QUOTE | DRAFT | SENT | PAID | OVERDUE
  issueDate       DateTime  @default(now())
  dueDate         DateTime?
  subtotalMinor   Int       @default(0)
  vatRate         Int       @default(18)     // 18% Georgian VAT (დღგ)
  vatMinor        Int       @default(0)
  totalMinor      Int       @default(0)
  currency        String    @default("GEL")
  includeVat      Boolean   @default(true)
  bankPreference  String    @default("BOG_TBC") // BOG | TBC | BOG_TBC
  rsGeWaybillRef  String?   // RS.ge ზედნადების / ფაქტურის ნომერი
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int     @default(1)
  unit        String  @default("ცალი")
  unitMinor   Int     @default(0)
  totalMinor  Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// —— Company Feed / Announcements (სიახლეები) & Team Chat (ჩატი) ——
model FeedPost {
  id        String   @id @default(cuid())
  companyId String
  authorId  String
  title     String
  body      String
  category  String   @default("ANNOUNCEMENT") // ANNOUNCEMENT | WIN | UPDATE | HR
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  companyId String
  authorId  String
  channel   String   @default("general") // general | sales | support | management
  body      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId, channel, createdAt])
}

// —— HR, Org Structure & Worktime Clock-In/Out (HR & სამუშაო დრო) ——
model Department {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  headName   String?
  parentName String?
  memberCount Int     @default(1)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WorkLog {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  status     String    @default("WORKING") // WORKING | COMPLETED
  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  note       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, clockInAt])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  leaveType String   @default("VACATION") // VACATION | SICK | DAY_OFF | REMOTE
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  reason    String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// —— Pipeline Automation Rules (ავტომატიზაცია / რობოტები) ——
model AutomationRule {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  triggerStageId String
  actionType     String   @default("CREATE_TASK") // CREATE_TASK | SEND_SMS | POST_FEED
  actionDetail   String   // Task title or SMS template
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, triggerStageId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  detail     String? // JSON, never passwords/tokens
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceMinor   Int      @default(0)
  currency     String   @default("GEL")
  interval     String   @default("month") // month | year
  maxUsers     Int      @default(5)
  maxCustomers Int      @default(100)
  maxDeals     Int      @default(200)
  trialDays    Int      @default(14)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  externalCustomerId     String?
  externalSubscriptionId String?
  lastPaymentFailureAt   DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan           @relation(fields: [planId], references: [id])
  events  BillingEvent[]
}

model BillingEvent {
  id              String   @id @default(cuid())
  subscriptionId  String
  provider        String   @default("dev")
  externalEventId String
  eventType       String
  payload         String // JSON
  processedAt     DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([subscriptionId])
}
