{
  "name": "crm-solution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma-command.mjs migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/prisma-command.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean-demo": "tsx scripts/clean-legacy-demo.ts --remove-alpha-beta",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "node --env-file-if-exists=.env scripts/prisma-command.mjs studio",
    "postinstall": "prisma generate || echo [warn] prisma generate skipped — stop running Node servers and run: npx prisma generate",
    "setup": "npm run db:deploy && npm run db:generate && npm run db:seed",
    "db:generate": "node --env-file-if-exists=.env scripts/prisma-command.mjs generate",
    "inbox:worker": "node --env-file-if-exists=.env --import tsx src/workers/inbox.ts",
    "inbox:seed": "node --env-file-if-exists=.env --import tsx prisma/seed-inbox.ts",
    "test:inbox": "vitest run tests/inbox",
    "db:postgres:sync": "node scripts/sync-postgres-schema.mjs",
    "db:postgres:check": "node scripts/sync-postgres-schema.mjs --check",
    "production:check": "node --env-file-if-exists=.env --import tsx scripts/production-check.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs create",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.mjs restore",
    "release:smoke": "node scripts/smoke.mjs",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "test:postgres": "node scripts/verify-postgres.mjs",
    "build:live": "node --env-file=.env.live.local scripts/build.mjs",
    "production:check:live": "node --env-file=.env.live.local --import tsx scripts/production-check.ts",
    "db:deploy:live": "node --env-file=.env.live.local scripts/prisma-command.mjs migrate deploy",
    "backup:live": "node --env-file=.env.live.local scripts/backup.mjs create",
    "services:check": "node --env-file=.env.live.local --import tsx scripts/check-services.ts",
    "db:configure:live": "node --env-file=.env.live.local scripts/configure-live-database.mjs",
    "db:runtime:live": "node --env-file=.env.live.local --import tsx scripts/provision-runtime.ts",
    "db:generate:live": "node --env-file=.env.live.local scripts/prisma-command.mjs generate",
    "backup:scheduled": "node --env-file=.env.live.local scripts/scheduled-backup.mjs",
    "db:backup-role:live": "node --env-file=.env.live.local --import tsx scripts/provision-backup.ts",
    "build:preview": "node --env-file=.env.preview.local scripts/build.mjs",
    "deploy:preview": "python scripts/check-deploy-artifacts.py --strip-generated-env && node --env-file=.env.preview.local scripts/netlify-command.mjs deploy --no-build --dir .netlify/static --prod --json",
    "netlify:build:preview": "node --env-file=.env.preview.local scripts/netlify-command.mjs build",
    "netlify:configure:preview": "node scripts/configure-netlify-preview.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.1.0",
    "json-bigint": "^1.0.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "next-intl": "^4.3.9",
    "nodemailer": "^10.3.1",
    "prisma": "^6.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tar": "^7.5.22",
    "tsx": "^4.20.5",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
